{
  "name": "homeboard",
  "version": "1.0.0",
  "description": "Party dashboard for the TV, controlled from phones",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "party": "tsx server/run.ts --kiosk"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/svelte": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.5",
    "socket.io-client": "^4.8.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "type": "module"
}
