# Copy this file to .env and fill in what you need. Everything is optional.
# .env is not in git, so your own values stay on your PC.

# Server port
# PORT=4300

# Your own domain through a named Cloudflare tunnel (see "Own domain" in the README).
# When set, it replaces the domain from the admin page.
# HB_DOMAIN=example.com
# HB_TUNNEL_NAME=homeboard

# 0: no public tunnel, home network only
# HB_TUNNEL=0

# Position of the TV window when it opens on a second screen
# HB_TV_POSITION=1920,0

# Browser for the TV window (found automatically otherwise)
# HB_BROWSER=C:/Program Files/Google/Chrome/Application/chrome.exe

# Another data folder, to run a test copy without touching the real guests and settings
# HB_DATA_DIR=./data-test
